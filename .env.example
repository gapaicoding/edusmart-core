# BUILD-TIME PUBLIC VARIABLES
# These values are embedded in the browser bundle. Supply them as Docker/Coolify
# build arguments for the correct isolated Supabase environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# BUILD TARGET
NITRO_PRESET=node-server

# RUNTIME SERVER VARIABLES
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# RUNTIME SECRET VARIABLES
# Server-only. Never expose this as VITE_*, a Docker build argument, or build ENV.
SUPABASE_SERVICE_ROLE_KEY=
